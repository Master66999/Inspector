# PackCheck Backend Environment Configuration
PROJECT_NAME="PackCheck Backend"
VERSION="1.0.0"
DEBUG=True

# Host & Port
HOST=0.0.0.0
PORT=8000

# Open Food Facts API Configuration
OPENFOODFACTS_BASE_URL="https://world.openfoodfacts.org/api/v2"
OPENFOODFACTS_USER_AGENT="PackCheck - Food and Beverage Scanner - Version 1.0 - https://github.com/PackCheck/PackCheck"
OPENFOODFACTS_TIMEOUT_SECONDS=10.0

# Database Configuration (PostgreSQL - Phase 3)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/packcheck_db"
SECRET_KEY="packcheck-production-secret-key-change-in-production"

# CORS Configuration
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Jev AI (TypeSafe AI System One Decision Engine) Configuration
# Obtain your API key from console.typesafe.ai
JEV_API_KEY="your-typesafe-jev-api-key-here"
JEV_API_URL="https://api.typesafe.ai/v1/systemone"
JEV_MODEL="jev-latest"

